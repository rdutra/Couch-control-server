<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VersionPrefix>0.1.0</VersionPrefix>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-mvp</InformationalVersion>
    <Company>CouchCTRL</Company>
    <Product>CouchCTRL Windows Companion</Product>
    <Authors>CouchCTRL</Authors>
    <Copyright>Copyright CouchCTRL</Copyright>
    <PackageProjectUrl>https://couchctrl.app</PackageProjectUrl>
  </PropertyGroup>
</Project>
